# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js
/.next/
/out/

# Production build artifacts
/build
/dist

# Standalone output (produced by `next build` with output: "standalone")
/.standalone/

# Environment / secrets — never commit
.env
.env.*
!.env.example
*.pem

# Local WMS data store (JSON persistence adapter)
/data/*.json
!/data/.gitkeep

# Testing
/coverage
/.nyc_output
*.lcov

# Misc
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# TypeScript / ESLint caches
*.tsbuildinfo
.eslintcache
