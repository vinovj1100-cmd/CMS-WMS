# ============================================================================
# WMS — environment configuration
# Copy to `.env` for local development. `.env*` (except this file) is gitignored.
# This is a demo configuration; do not reuse it for a production deployment.
# ============================================================================

# --- Application -----------------------------------------------------------
# Absolute origin of the deployment. Used for metadataBase, absolute URLs in
# emails/reports and for validating the Origin header (CSRF defence).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js sets NODE_ENV for dev/build/start. Do not pin it in a shared .env:
# production refuses insecure defaults (see lib/security/config.ts).

# Allow embedding only for an isolated, non-sensitive development preview.
# This uses Secure partitioned cookies and requires HTTPS (or localhost).
# Never use this mode with real warehouse data; ignored in production.
WMS_PREVIEW_EMBED=false

# --- Security --------------------------------------------------------------
# Master secret for HMAC-signing session cookies. MUST be at least 32 bytes of
# randomness in anything beyond local dev. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
WMS_SESSION_SECRET=

# Session cookie lifetime in seconds (default 8 hours — one warehouse shift).
WMS_SESSION_TTL_SECONDS=28800

# Enforce Content-Security-Policy (set at build time). Set false for report-only
# diagnostics in staging; keep it enabled in production.
CSP_ENFORCE=true

# Login rate limit: max failures per window before the account is locked.
WMS_LOGIN_MAX_ATTEMPTS=5
WMS_LOGIN_WINDOW_SECONDS=900

# Password hashing cost for scrypt (N). 2^15 = 32768 iterations.
WMS_SCRYPT_N=32768

# --- Data ------------------------------------------------------------------
# Storage driver: "memory" (ephemeral) or "file" (JSON on disk).
# The sample uses file storage so demo transactions survive restarts. A real
# database adapter is needed before any multi-instance or production rollout.
WMS_STORAGE_DRIVER=file

# Directory used by the "file" driver. Must be writable and persistent in prod.
WMS_DATA_DIR=./data

# Seed the demo warehouse (SKUs, locations, orders, users) into an empty store.
# Set false in production, and never reuse a store containing demo accounts.
WMS_SEED_DEMO_DATA=true

# --- Observability ---------------------------------------------------------
# Emit a structured JSON audit record for every mutating API call.
WMS_AUDIT_LOG=true
